//! Look-alike code points to the letters they stand for, so search and citations match what a reader typed:
//! Kangxi and supplement radicals (U+2E80..2FDF) to unified ideographs, and
//! Arabic presentation forms (U+FB50..FDFF, U+FE70..FEFF) to the letters
//! they shape. Generated by crates/recto/tools/gen-forms.py from Unicode NFKC (Unicode
//! {VERSION}), keeping results made only of ideographs or Arabic-block
//! letters; initial and medial Farsi yeh (U+FBFE, U+FBFF) read as Arabic
//! yeh, the glyph they share.

static FORMS: &[(u32, &str)] = &[
{FORMS}
];

/// The letters a look-alike stands for, or `None` if `c` is not one.
pub fn base_letters(c: char) -> Option<&'static str> {
    FORMS
        .binary_search_by_key(&(c as u32), |&(cp, _)| cp)
        .ok()
        .map(|i| FORMS[i].1)
}

/// `text` with every look-alike replaced by its letters.
pub fn normalize(text: String) -> String {
    if !text.chars().any(|c| base_letters(c).is_some()) {
        return text;
    }
    text.chars()
        .map(|c| base_letters(c).map_or_else(|| c.to_string(), str::to_string))
        .collect()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn look_alikes_read_as_letters() {
        // heh initial, lam-alef ligature, yeh medial, alef final.
        assert_eq!(
            normalize("\u{FEEB}\u{FEFB}\u{FEF4}\u{FE8E}".into()),
            "\u{0647}\u{0644}\u{0627}\u{064A}\u{0627}"
        );
        assert_eq!(normalize("\u{FBFE}".into()), "\u{064A}");
        assert_eq!(normalize("abc".into()), "abc");
        // Kangxi radicals for 文 and 用, as Chrome's Noto CJK maps them.
        assert_eq!(normalize("中\u{2F42}\u{2F64}".into()), "中文用");
    }
}
